# Copy to .env and fill in. Never commit .env.
# Used by `docker compose` (see compose.yaml) and local `npm run dev`.

# --- Postgres (compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stytchup

# --- Backend ---
# The compose stack overrides this to point at the postgres service.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/stytchup
JWT_SECRET=change-me-jwt
NEXTAUTH_SECRET=change-me-nextauth-must-match-frontend
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PORT=4000

# --- Frontend (React Vite: baked at docker build via compose.yaml args) ---
VITE_API_URL=http://localhost:4000
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_CLIENT_ID=
